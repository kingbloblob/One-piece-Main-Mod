        { "buy": "onepiece:berry", "buyCount": 8, "sell": "onepiece:sea_king_bait", "sellCount": 1, "maxUses": 4 }
      ],
      "lines": ["The fish are biting today!", "Saw a Sea King's fin out past the reef. Stay away from the deep water.",
                "My grandpa caught a fish as big as a ship. Or so he says.", "Want fresh fish? Caught this morning!"]
    },
    "sailor": {
      "title": "Sailor", "skin": "sailor", "workAt": "water", "brawler": true, "nightOwl": true,
      "lines": ["Ever sailed the Grand Line? It eats ships like crackers.", "Buy me a drink and I'll tell you about the Calm Belt.",
                "I heard the Log Pose needles go crazy near Fish-Man Island.", "Arr, what are you looking at?",
                "Rumour is a Yonko ship was spotted near here. I'm staying ashore!"]
    },
