        { "buy": "onepiece:berry", "buyCount": 2, "sell": "minecraft:apple", "sellCount": 4 }
      ],
      "lines": ["Good soil this year. The crops are coming up nicely.", "If you've got wheat to sell, I'll pay fair Berries.",
                "Pirates trampled my field last month. Not you, I hope?", "Nothing beats a mikan picked straight off the tree."]
    },
    "fisher": {
      "title": "Fisher", "skin": "fisher", "workAt": "water", "hold": "minecraft:fishing_rod",
      "trades": [
        { "buy": "onepiece:berry", "buyCount": 2, "sell": "minecraft:cod", "sellCount": 6 },
